    "tracking": "text"
   },
   "amount": {
    "size": "16",
    "lineHeight": "24",
    "weight": "medium",
    "tracking": "text",
    "features": "tnum"
   },
   "titleS": {
    "size": "18",
    "lineHeight": "24",
    "weight": "semibold",
    "tracking": "title"
   },
   "titleM": {
    "size": "24",
    "lineHeight": "32",
    "weight": "semibold",
    "tracking": "title"
   },
   "titleL": {
    "size": "32",
    "lineHeight": "40",
    "weight": "semibold",
    "tracking": "display"
   },
   "display": {
    "size": "40",
    "lineHeight": "48",
    "weight": "semibold",
    "tracking": "display"
   }
  },
  "color": {
   "light": {
    "surface": "white",
    "surfaceRaised": "paper",
    "textPrimary": "ink",
    "textSecondary": "graphite",
    "border": "stone",
    "accent": "green",
    "onAccent": "white",
    "danger": "red",
    "focus": "blue"
   },
   "dark": {
    "surface": "black",
    "surfaceRaised": "raised",
    "textPrimary": "ink",
    "textSecondary": "graphite",
    "border": "stone",
    "accent": "green",
    "onAccent": "greenOn",
    "danger": "red",
    "focus": "blue"
   }
  }
 },
 "component": {
  "button": {
   "label": "label"
  },
  "input": {
   "value": "body",
   "placeholder": "body",
   "helper": "caption"
  },
  "price": {
   "value": "amount"
  },
  "tab": {
   "label": "label"
  },
  "navbar": {
   "title": "titleS"
  },
  "listItem": {
   "title": "bodyStrong",
   "subtitle": "caption"
  },
  "toast": {
   "message": "body"
  }
 }
}