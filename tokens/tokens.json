{
 "$description": "Synthetix UI design tokens (W3C DTCG format). Three layers: primitive -> semantic -> component. PROPOSED values: type scale, tracking and palette are placeholders pending product/brand review.",
 "primitive": {
  "font": {
   "family": {
    "$type": "fontFamily",
    "$value": "Synthetix UI"
   },
   "weight": {
    "regular": {
     "$type": "fontWeight",
     "$value": 400
    },
    "medium": {
     "$type": "fontWeight",
     "$value": 500
    },
    "semibold": {
     "$type": "fontWeight",
     "$value": 600
    },
    "medium-dark": {
     "$type": "fontWeight",
     "$value": 470,
     "$description": "dark-mode counterpart of medium (light text on dark reads heavier); variable axis only"
    },
    "semibold-dark": {
     "$type": "fontWeight",
     "$value": 570,
     "$description": "dark-mode counterpart of semibold; variable axis only"
    }
   },
   "size": {
    "12": {
     "$type": "dimension",
     "$value": "0.75rem"
    },
    "14": {
     "$type": "dimension",
     "$value": "0.875rem"
    },
    "16": {
     "$type": "dimension",
     "$value": "1rem"
    },
    "18": {
     "$type": "dimension",
     "$value": "1.125rem"
    },
    "24": {
     "$type": "dimension",
     "$value": "1.5rem"
    },
    "32": {
     "$type": "dimension",
     "$value": "2rem"
    },
    "40": {
     "$type": "dimension",
     "$value": "2.5rem"
    }
   },
   "lineHeight": {
    "16": {
     "$type": "dimension",
     "$value": "1rem"
    },
    "20": {
     "$type": "dimension",
     "$value": "1.25rem"
    },
    "24": {
     "$type": "dimension",
     "$value": "1.5rem"
    },
    "32": {
     "$type": "dimension",
     "$value": "2rem"
    },
    "40": {
     "$type": "dimension",
     "$value": "2.5rem"
    },
    "48": {
     "$type": "dimension",
     "$value": "3rem"
    }
   },
   "tracking": {
    "caption": {
     "$type": "dimension",
     "$value": "0.005em"
    },
    "text": {
     "$type": "dimension",
     "$value": "0em"
    },
    "title": {
     "$type": "dimension",
     "$value": "-0.005em"
    },
    "display": {
     "$type": "dimension",
     "$value": "-0.012em"
    }
   }
  },
  "color": {
   "light": {
    "white": "#FFFFFF",
    "paper": "#F6F6F4",
    "ink": "#111111",
    "graphite": "#5C5C5C",
    "stone": "#8A8A8A",
    "green": "#0B6E4F",
    "red": "#B3261E",
    "blue": "#1A56DB"
   },
   "dark": {
    "black": "#121212",
    "raised": "#1E1E1E",
    "ink": "#F2F2F2",
    "graphite": "#A9A9A9",
    "stone": "#7A7A7A",
    "green": "#5FD3A5",
    "greenOn": "#08281D",
    "red": "#FF8A80",
    "blue": "#8AB4FF"
   }
  }
 },
 "semantic": {
  "type": {
   "caption": {
    "size": "12",
    "lineHeight": "16",
    "weight": "regular",
    "tracking": "caption"
   },
   "label": {
    "size": "14",
    "lineHeight": "20",
    "weight": "medium",
    "tracking": "text"
   },
   "body": {
    "size": "16",
    "lineHeight": "24",
    "weight": "regular",
    "tracking": "text"
   },
   "bodyStrong": {
    "size": "16",
    "lineHeight": "24",
